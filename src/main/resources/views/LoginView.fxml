<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.romraider.controllers.LoginController"
      alignment="CENTER" spacing="20" style="-fx-padding: 30;">

    <StackPane alignment="CENTER">
        <ImageView fitHeight="150" fitWidth="150" preserveRatio="true">
            <image>
                <Image url="@/assets/romraider-logo.png"/>
            </image>
            <clip>
                <Circle radius="75" centerX="75" centerY="75"/>
            </clip>
        </ImageView>
    </StackPane>

    <Label text="%login.subtitle" style="-fx-font-size: 14px; -fx-text-fill: #555555;"/>

    <VBox spacing="8" maxWidth="300">
        <TextField fx:id="usernameField" promptText="%login.email"/>
        <PasswordField fx:id="passwordField" promptText="%login.password"/>

        <HBox spacing="10">
            <Button fx:id="loginButton" text="%login.button.login" onAction="#handleLogin" prefWidth="140"/>
            <Button fx:id="registerButton" text="%login.button.register" onAction="#handleRegister" prefWidth="140"/>
        </HBox>

        <CheckBox fx:id="rememberMeCheck" text="%login.rememberMe"/>
        <Label fx:id="messageLabel" textFill="red" wrapText="true"/>
    </VBox>

    <Separator prefWidth="320"/>

    <VBox spacing="5" alignment="CENTER">
        <Label text="%login.noInternet" style="-fx-text-fill: #666666;"/>
        <Button text="%login.offline" onAction="#handleOffline"/>
    </VBox>
</VBox>
