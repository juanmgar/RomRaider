<?xml version="1.0" encoding="UTF-8"?>
<!-- LoginView.fxml -->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.romraider.controllers.LoginController"
      alignment="CENTER" spacing="10" style="-fx-padding: 30;">

    <Label text="ROM RAIDER - Login" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    <HBox spacing="10">
        <Button text="Login" onAction="#handleLogin"/>
        <Button text="Register" onAction="#handleRegister"/>
    </HBox>
    <CheckBox fx:id="rememberMeCheck" text="Remember me"/>
    <Label fx:id="messageLabel" textFill="red"/>
    <Button text="Continue Offline" onAction="#handleOffline"/>
</VBox>