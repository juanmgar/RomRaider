<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.romraider.controllers.PreferencesController">

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label text="%preferences.copyFolder" style="-fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="copyPathField" prefWidth="300"/>
                <Button text="%preferences.browse" onAction="#handleBrowseFolder"/>
            </HBox>

            <Separator/>

            <Label text="%preferences.language" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="languageCombo" prefWidth="150"/>

            <Separator/>

            <CheckBox fx:id="autoUpdateCheckBox" text="%preferences.autoUpdateRawg"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button text="%preferences.save" onAction="#handleSave"/>
            <Button text="%preferences.cancel" onAction="#handleCancel"/>
        </HBox>
    </bottom>

</BorderPane>
