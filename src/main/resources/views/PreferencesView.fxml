<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.romraider.controllers.PreferencesController">

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label text="ROM Copy Folder" style="-fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="copyPathField" prefWidth="300"/>
                <Button text="Browse" onAction="#handleBrowseFolder"/>
            </HBox>

            <Separator/>

            <CheckBox fx:id="autoUpdateCheckBox" text="Enable automatic data updates from RAWG.io"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button text="Save" onAction="#handleSave"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>
    </bottom>

</BorderPane>