<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.romraider.controllers.RomFormController">

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label text="ROM Details" style="-fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Title:"/>
                <TextField fx:id="titleField" prefWidth="300"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Description:"/>
                <TextArea fx:id="descriptionArea" prefWidth="300" prefHeight="100"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Image:"/>
                <TextField fx:id="imageField" prefWidth="250"/>
                <Button text="Browse" onAction="#handleBrowseImage"/>
            </HBox>

            <HBox spacing="10">
                <CheckBox fx:id="favoriteCheckBox" text="Favorite"/>
                <CheckBox fx:id="playedCheckBox" text="Played"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="saveButton" text="Save" onAction="#handleSave" disable="true"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>
    </bottom>

</BorderPane>
