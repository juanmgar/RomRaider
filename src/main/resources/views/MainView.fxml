<?xml version="1.0" encoding="UTF-8"?>
<!-- MainView.fxml -->

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.romraider.controllers.MainController">

    <top>
        <VBox>
            <MenuBar fx:id="menuBar">
                <menus>
                    <Menu text="File">
                        <MenuItem text="Scan Folder" onAction="#handleScanFolder"/>
                        <MenuItem text="Export" onAction="#handleExport"/>
                        <MenuItem text="Import" onAction="#handleImport"/>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="loginLogoutMenuItem" text="Logout" onAction="#handleLoginLogout"/>
                    </Menu>
                    <Menu text="View">
                        <MenuItem text="Statistics" onAction="#handleViewStatistics"/>
                    </Menu>
                    <Menu text="Settings">
                        <MenuItem text="Preferences" onAction="#handleSettings"/>
                        <MenuItem text="About" onAction="#handleCredits"/>
                    </Menu>
                </menus>
            </MenuBar>
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                <Label text="ROM RAIDER" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>

                <!-- Backup to Cloud -->
                <Button fx:id="backupButton" onAction="#handleBackup">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/assets/up.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Upload your local data to the cloud"/>
                    </tooltip>
                </Button>

                <!-- Restore from Cloud -->
                <Button fx:id="restoreButton" onAction="#handleRestore">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@/assets/down.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Download and restore your data from the cloud"/>
                    </tooltip>
                </Button>

                <Label fx:id="userLabel"/>
            </HBox>

        </VBox>
    </top>


    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="searchField" promptText="Search ROMs..." onKeyReleased="#handleSearch"/>
            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Platforms" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="platformListView" prefWidth="150"/>
                    <VBox spacing="5">
                        <!-- Add Platform -->
                        <Button onAction="#handleAddPlatform" maxWidth="Infinity">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@/assets/new.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Add a new platform to your collection"/>
                            </tooltip>
                        </Button>

                        <!-- Edit Platform -->
                        <Button onAction="#handleEditPlatform" maxWidth="Infinity">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@/assets/edit.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Edit the selected platform"/>
                            </tooltip>
                        </Button>

                        <!-- Delete Platform -->
                        <Button onAction="#handleDeletePlatform" maxWidth="Infinity">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@/assets/delete.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Delete the selected platform"/>
                            </tooltip>
                        </Button>
                    </VBox>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="ROMs" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="romListView" HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT">
                        <!-- Add ROM -->
                        <Button onAction="#handleAddRom"
                                style="-fx-pref-width: 40px;">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                    <image>
                                        <Image url="@/assets/new.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Add a new ROM"/>
                            </tooltip>
                        </Button>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true" style="-fx-padding: 10;">
            <VBox spacing="10">
                <Label text="ROM Details" style="-fx-font-size: 16px;"/>
                <StackPane prefHeight="100" prefWidth="100">
                    <ImageView fx:id="romImage" fitHeight="250" fitWidth="250"
                               preserveRatio="true" smooth="true"/>
                </StackPane>
                <Label text="Description:"/>
                <TextArea fx:id="romDescription" wrapText="true" editable="false" prefRowCount="6"/>

                <CheckBox text="Favorite" fx:id="favoriteCheckBox" disable="true"/>
                <CheckBox text="Played" fx:id="playedCheckBox" disable="true"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Pane HBox.hgrow="ALWAYS"/> <!-- Empuja los botones a la derecha -->

                    <!-- Edit -->
                    <Button onAction="#handleEditRom">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                <image>
                                    <Image url="@/assets/edit.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Edit selected ROM"/>
                        </tooltip>
                    </Button>

                    <!-- Delete -->
                    <Button onAction="#handleDeleteRom">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                <image>
                                    <Image url="@/assets/delete.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Delete selected ROM"/>
                        </tooltip>
                    </Button>

                    <!-- RAWG -->
                    <Button onAction="#handleUpdateFromAPI">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                                <image>
                                    <Image url="@/assets/cloud.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Fetch description and image from RAWG API"/>
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
