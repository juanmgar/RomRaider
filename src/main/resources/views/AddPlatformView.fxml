<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.romraider.controllers.AddPlatformController">

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Add Platform" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="10">
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Extension (e.g., .nes):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="extField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Folder name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="folderField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10;">
            <Button fx:id="saveButton" text="Save" onAction="#handleSave" disable="true"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>
    </bottom>
</BorderPane>
