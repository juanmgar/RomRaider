<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
    <persistence-unit name="romraiderPU" transaction-type="RESOURCE_LOCAL">
        <class>com.romraider.model.Plataforma</class>
        <class>com.romraider.model.Rom</class>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
